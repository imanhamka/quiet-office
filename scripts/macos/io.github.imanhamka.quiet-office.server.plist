<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template for the Quiet Office data server. scripts/macos/install.sh replaces
     __HOME__, __ROOT__ (repo root) and __NODE__ (node binary) with absolute paths:
     launchd expands neither ~ nor $HOME. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.imanhamka.quiet-office.server</string>
	<key>ProgramArguments</key>
	<array>
		<string>__NODE__</string>
		<string>__ROOT__/server/server.mjs</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>QUIET_OFFICE_PORT</key>
		<string>47100</string>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Background</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/quiet-office/server.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/quiet-office/server.log</string>
</dict>
</plist>
