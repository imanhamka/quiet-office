<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- LaunchAgent template for the Quiet Office macOS host. scripts/macos/install.sh replaces
     __HOME__ and __ROOT__ (repo root) with absolute paths: launchd expands neither ~ nor $HOME.
     A clean Quit (exit 0) is not restarted; a crash is. -->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>io.github.imanhamka.quiet-office.host</string>
	<key>ProgramArguments</key>
	<array>
		<string>__ROOT__/hosts/macos/build/QuietOffice.app/Contents/MacOS/QuietOffice</string>
	</array>
	<key>EnvironmentVariables</key>
	<dict>
		<key>QUIET_OFFICE_PORT</key>
		<string>47100</string>
	</dict>
	<key>LimitLoadToSessionType</key>
	<string>Aqua</string>
	<key>ProcessType</key>
	<string>Interactive</string>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ThrottleInterval</key>
	<integer>10</integer>
	<key>StandardOutPath</key>
	<string>__HOME__/Library/Logs/quiet-office/host.log</string>
	<key>StandardErrorPath</key>
	<string>__HOME__/Library/Logs/quiet-office/host.log</string>
</dict>
</plist>
